# Рядок підключення до PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/legal_consult"

# Порт HTTP-сервера
PORT=3000

# Дозволений origin для CORS (адреса фронтенду)
FRONTEND_URL="http://localhost:5173"

# Секрети JWT (генеруються командою: node -p "require('node:crypto').randomBytes(32).toString('hex')")
JWT_SECRET="згенерований-секрет-1"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET="згенерований-секрет-2"
REFRESH_TOKEN_EXPIRES_IN=7d

# Файловий сервіс
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate limiting для /api/ і окремо посилений для /api/auth (login, 2FA тощо)
RATE_LIMIT=100
AUTH_RATE_LIMIT=10

# SMTP для листів відновлення паролю (опціонально; без нього листи логуються в консоль)
# SMTP_URL="smtp://user:pass@smtp.example.com:587"

# Rate limiting подій WebSocket на один socket (подій за 10 секунд)
WS_RATE_LIMIT=30

# Redis (опціонально): якщо задано REDIS_URL — кеш і Socket.io-адаптер працюють через Redis
# (горизонтальне масштабування кількома інстансами)
# REDIS_URL="redis://localhost:6379"

# Лог усіх SQL-запитів Prisma з тривалістю (пошук повільних запитів, EXPLAIN ANALYZE)
# PRISMA_LOG_QUERY=1
