# Окрема тестова база даних (npm test підставляє її через --env-file-if-exists)
DATABASE_URL="postgresql://user:password@localhost:5432/legal_consult_test"
PORT=3100
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="test-jwt-secret"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET="test-refresh-secret"
REFRESH_TOKEN_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
# у тестах ліміти вимкнено, щоб не ловити 429
RATE_LIMIT=100000
AUTH_RATE_LIMIT=100000
